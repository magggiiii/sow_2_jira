# .env.local.example — local development environment (APP_ENV=local)
#
# Copy to `.env.local` (gitignored) and fill in. The app loads this before
# building `config.settings.Settings`; only the composition root
# (`app.container.build_container`) branches on these to pick adapters.
#
# Authoritative spec: .planning/elevation/ENV-CONFIG.md
# Local stack bring-up: scripts/dev-local-up.sh  (supabase start + redis:7)

# ── The one flip ──────────────────────────────────────────────────────────────
APP_ENV=local

# ── Postgres — Supabase LOCAL stack (`supabase start`; Postgres 17 @ :54322) ──
# Alembic owns the schema: `alembic upgrade head` against this DATABASE_URL.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ── Object storage — Supabase LOCAL Storage S3 (MinIO dropped) ────────────────
# Values come from `supabase status` (S3_PROTOCOL_ACCESS_KEY_ID/_SECRET).
# One boto3 adapter, path-style addressing.
S3_ENDPOINT=http://127.0.0.1:54321/storage/v1/s3
S3_ACCESS_KEY=
S3_SECRET=
S3_REGION=local
S3_BUCKET=sow-uploads

# ── Queue / worker — Docker redis:7 + arq. Unset REDIS_URL → in-process queue. ─
REDIS_URL=redis://127.0.0.1:6379/0

# ── Encryption (Fernet) — generate a dev key, DO NOT reuse in production ───────
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_ENC_KEY=
# APP_ENC_KEY_OLD=   # set only during key rotation

# ── Auth — `local` seeds a dev-login (test tenancy); `off` = single dev user ──
AUTH_MODE=local
# For AUTH_MODE=oauth (Google, restricted to @calibraint.com):
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# AUTH_CALLBACK_URL=http://127.0.0.1:8000/api/auth/callback

# ── LLM gateway (Bifrost) — same base URL both envs (LOCKED code) ─────────────
BIFROST_BASE_URL=http://65.1.177.144:8080/

# ── Observability (Langfuse) — env creds both envs ────────────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ── Jira — env creds both envs (single shared account; per-user deferred) ─────
JIRA_SERVER=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=

# ── CORS — the browser origin(s) allowed to call the API ──────────────────────
APP_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
